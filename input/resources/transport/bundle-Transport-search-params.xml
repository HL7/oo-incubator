<?xml version="1.0" encoding="UTF-8"?>

<Bundle xmlns="http://hl7.org/fhir">
  <id value="Transport-search-params"/>
  <!--
    Search parameters are defined for the PRODUCTION model of Transport, in which
    the referenced resources (Patients, Locations, the transported focus item,
    prior Transports) are independent, server-addressable resources
    (e.g. Patient/123, Location/456).

    The Transport EXAMPLES in this IG instead package those supporting resources as
    *contained* resources so each example is a single self-contained file. As a
    result, the reference-based parameters below (patient, subject, from, to, focus,
    prior-transport) will not resolve to searchable targets within the examples,
    because their referents are contained (#local) resources with no independent
    identity. This is a property of the example packaging only, not of the search
    parameters: against production data where these resources are referenceable,
    the parameters resolve and search normally.
  -->
  <entry>
    <resource>
      <SearchParameter>
        <id value="Transport-identifier"/>
        <extension url="http://hl7.org/fhir/StructureDefinition/structuredefinition-standards-status">
          <valueCode value="trial-use"/>
        </extension>
        <extension url="http://hl7.org/fhir/build/StructureDefinition/path">
          <valueString value="Transport.identifier"/>
        </extension>
        <url value="http://hl7.org/fhir/build/SearchParameter/Transport-identifier"/>
        <name value="TransportIdentifierSearchParameter"/>
        <description value="External identifier"/>
        <status value="active"/>
        <code value="identifier"/>
        <type value="token"/>
        <expression value="Transport.identifier"/>
        <processingMode value="normal"/>
      </SearchParameter>
    </resource>
  </entry>
  <entry>
    <resource>
      <SearchParameter>
        <id value="transport-status"/>
        <extension url="http://hl7.org/fhir/StructureDefinition/structuredefinition-standards-status">
          <valueCode value="trial-use"/>
        </extension>
        <extension url="http://hl7.org/fhir/build/StructureDefinition/path">
          <valueString value="Transport.status"/>
        </extension>
        <url value="http://hl7.org/fhir/build/SearchParameter/Transport-status"/>
        <name value="TransportStatusSearchParameter"/>
        <description value="in-progress | completed | entered-in-error"/>
        <status value="active"/>
        <code value="status"/>
        <type value="token"/>
        <expression value="Transport.status"/>
        <processingMode value="normal"/>
      </SearchParameter>
    </resource>
  </entry>
  <entry>
    <resource>
      <SearchParameter>
        <id value="Transport-patient"/>
        <extension url="http://hl7.org/fhir/StructureDefinition/structuredefinition-standards-status">
          <valueCode value="trial-use"/>
        </extension>
        <extension url="http://hl7.org/fhir/build/StructureDefinition/path">
          <valueString value="Transport.subject"/>
        </extension>
        <url value="http://hl7.org/fhir/build/SearchParameter/Transport-patient"/>
        <name value="TransportPatientSearchParameter"/>
        <description value="Search by subject - a patient"/>
        <status value="active"/>
        <code value="patient"/>
        <type value="reference"/>
        <expression value="Transport.subject.where(resolve() is Patient)"/>
        <target value="Patient"/>
        <processingMode value="normal"/>
      </SearchParameter>
    </resource>
  </entry>
  <entry>
    <resource>
      <SearchParameter>
        <id value="Transport-subject"/>
        <extension url="http://hl7.org/fhir/StructureDefinition/structuredefinition-standards-status">
          <valueCode value="trial-use"/>
        </extension>
        <extension url="http://hl7.org/fhir/build/StructureDefinition/path">
          <valueString value="Transport.subject"/>
        </extension>
        <url value="http://hl7.org/fhir/build/SearchParameter/Transport-subject"/>
        <name value="TransportSubjectSearchParameter"/>
        <description value="Search for subject"/>
        <status value="active"/>
        <code value="subject"/>
        <type value="reference"/>
        <expression value="Transport.subject"/>
        <target value="Group"/>
        <target value="Patient"/>
        <processingMode value="normal"/>
      </SearchParameter>
    </resource>
  </entry>
  <entry>
    <resource>
      <SearchParameter>
