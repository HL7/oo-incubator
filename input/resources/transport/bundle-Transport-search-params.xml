          <valueString value="Transport.to"/>
        </extension>
        <url value="http://hl7.org/fhir/build/SearchParameter/Transport-to"/>
        <name value="TransportToSearchParameter"/>
        <description value="Destination location the item is transported to"/>
        <status value="active"/>
