        <description value="Originating location the item is transported from"/>
        <status value="active"/>
        <code value="from"/>
        <type value="reference"/>
        <expression value="Transport.from"/>
        <target value="Location"/>
        <processingMode value="normal"/>
      </SearchParameter>
    </resource>
  </entry>
  <entry>
    <resource>
      <SearchParameter>
